GROQ_API_KEY=
PORT=3001
MAX_STEPS=12
MAX_ACTION_TOKENS=1024
MAX_REPEAT_ACTIONS=4
MAX_SCROLL_ATTEMPTS=4
NODE_ENV=development

# ─── Web UI / Docker noVNC ───────────────────────────────────
# Start the container first:  docker compose up -d
# Then point Playwright at its Chromium over CDP so the live
# browser is visible (and interactive) in the frontend's noVNC view.
# Leave commented out to run local Chrome as before.
# BROWSER_CDP_URL=http://localhost:9222

# Optional: keep a persistent Chrome profile / use installed Chrome
# PERSISTENT_PROFILE=false
# USE_REAL_CHROME=false
