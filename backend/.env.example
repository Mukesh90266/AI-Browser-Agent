# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Browser Display: false for visible browser window, true for background
HEADLESS=false

# PERSISTENT GOOGLE / CHROME LOGIN PROFILE
# Set PERSISTENT_PROFILE=true so that once you log in to Google in the browser,
# your account, cookies, and sessions remain permanently saved in ./user_data
PERSISTENT_PROFILE=true

# Optional: Set USE_REAL_CHROME=true to use your installed Google Chrome application
USE_REAL_CHROME=true

# Optional: To directly use your personal Windows Chrome profile, uncomment and set:
# USER_DATA_DIR=C:\Users\YOUR_PC_USERNAME\AppData\Local\Google\Chrome\User Data
